{{ define "style.gohtml" }}<style>
  :root {
    --bg: #ffffff; --fg: #111827; --muted: #6b7280; --line: #e5e7eb; --card: #ffffff;
    --ok-bg: #d1fae5; --ok-fg: #065f46;
    --attention-bg: #fef3c7; --attention-fg: #92400e;
    --urgent-bg: #fee2e2; --urgent-fg: #991b1b;
    --unknown-bg: #e5e7eb; --unknown-fg: #374151;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f172a; --fg: #e5e7eb; --muted: #94a3b8; --line: #1e293b; --card: #111827;
      --ok-bg: #064e3b; --ok-fg: #a7f3d0;
      --attention-bg: #78350f; --attention-fg: #fde68a;
      --urgent-bg: #7f1d1d; --urgent-fg: #fecaca;
      --unknown-bg: #1f2937; --unknown-fg: #d1d5db;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  main { max-width: 60rem; margin: 0 auto; padding: 2rem 1rem 3rem; }
  h1 { font-size: 1.6rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.15rem; margin: 2rem 0 .75rem; }
  a { color: inherit; }
  .muted { color: var(--muted); font-size: .9rem; }
  table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  th, td { text-align: left; padding: .6rem .5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: .85rem; color: var(--muted); font-weight: 600; }
  td.counts, th.counts { text-align: right; }
  .chip {
    display: inline-block; border-radius: 999px; padding: .1rem .55rem;
    font-size: .78rem; font-weight: 600; margin-left: .3rem;
  }
  .chip.ok { background: var(--ok-bg); color: var(--ok-fg); }
  .chip.attention { background: var(--attention-bg); color: var(--attention-fg); }
  .chip.urgent { background: var(--urgent-bg); color: var(--urgent-fg); }
  .chip.unknown { background: var(--unknown-bg); color: var(--unknown-fg); }
  .stale { color: var(--urgent-fg); font-size: .8rem; }
  .card {
    border: 1px solid var(--line); background: var(--card);
    border-radius: .5rem; padding: 1rem; margin-bottom: .75rem;
  }
  .card .head { display: flex; gap: .6rem; align-items: baseline; flex-wrap: wrap; }
  .check-id { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8rem; color: var(--muted); }
  .summary { margin: .5rem 0 0; }
  ul { margin: .4rem 0 0; padding-left: 1.2rem; }
  footer { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1rem; }
</style>
{{ end }}
