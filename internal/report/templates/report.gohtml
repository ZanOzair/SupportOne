{{- /*
A self-contained report: no external stylesheet, font or script. Severity is
carried by a written label as well as a colour, so the report is readable to
someone who cannot distinguish the colours or is printing in black and white.
*/ -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ .Title }}</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #f6f7f9;
    --surface: #ffffff;
    --border: #d7dbe0;
    --text: #16191d;
    --muted: #5a626b;
    --ok: #1c6b3c;
    --ok-bg: #e4f3ea;
    --attention: #8a5a00;
    --attention-bg: #fbf0d9;
    --urgent: #9b1c1c;
    --urgent-bg: #fbe4e4;
    --unknown: #3f4854;
    --unknown-bg: #e9ecef;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14171a;
      --surface: #1c2024;
      --border: #333a42;
      --text: #e8eaed;
      --muted: #a3acb6;
      --ok: #6ede9d;
      --ok-bg: #16301f;
      --attention: #f0c674;
      --attention-bg: #33290f;
      --urgent: #f79191;
      --urgent-bg: #3a1a1a;
      --unknown: #c3cad2;
      --unknown-bg: #262c33;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2rem 1rem 4rem;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  main { max-width: 52rem; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.15rem; margin: 2.5rem 0 .75rem; }
  p { margin: .4rem 0; }
  .muted { color: var(--muted); font-size: .9rem; }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: .6rem;
    padding: 1rem 1.1rem;
    margin: .75rem 0;
  }
  .chip {
    display: inline-block;
    padding: .12rem .55rem;
    border-radius: 999px;
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .01em;
    white-space: nowrap;
  }
  .chip.ok { color: var(--ok); background: var(--ok-bg); }
  .chip.attention { color: var(--attention); background: var(--attention-bg); }
  .chip.urgent { color: var(--urgent); background: var(--urgent-bg); }
  .chip.unknown { color: var(--unknown); background: var(--unknown-bg); }
  .counts { display: flex; flex-wrap: wrap; gap: .5rem; margin: .5rem 0 0; padding: 0; list-style: none; }
  .counts li { display: flex; align-items: baseline; gap: .35rem; }
  .counts .value { font-variant-numeric: tabular-nums; font-weight: 600; }
  .result-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; }
  .check-id { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .82rem; color: var(--muted); }
  .summary { margin: .5rem 0 0; }
  .cause { margin: .6rem 0 0; }
  .steps-label { margin: .6rem 0 .2rem; }
  .steps { margin: 0; padding-left: 1.2rem; }
  .steps li { margin: .15rem 0; }
  table { border-collapse: collapse; width: 100%; margin-top: .75rem; font-size: .9rem; }
  th, td { text-align: left; padding: .3rem .5rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { width: 12rem; font-weight: 600; color: var(--muted); }
  pre {
    margin: .6rem 0 0;
    padding: .7rem;
    overflow-x: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: .4rem;
    font-size: .82rem;
  }
  details { margin-top: .6rem; }
  summary { cursor: pointer; font-size: .9rem; color: var(--muted); }
  footer { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1rem; }
  .notice { border-left: 3px solid var(--attention); padding-left: .75rem; }
</style>
</head>
<body>
<main>
  <h1>{{ .Title }}</h1>
  <p class="muted">{{ .Strings.report_subtitle }}</p>

  <dl class="muted">
    <div><strong>{{ .Strings.report_machine }}:</strong> {{ .OS }} ({{ .Arch }})</div>
    <div><strong>{{ .Strings.report_generated }}:</strong> {{ .Generated }}</div>
    <div><strong>{{ .Strings.report_agent }}:</strong> {{ .Version }}{{ if .Unsigned }} — {{ .Strings.report_unsigned }}{{ end }}</div>
  </dl>

  {{ if .Redacted }}<p class="notice">{{ .Strings.report_redacted }}</p>{{ end }}

  <h2>{{ .Strings.report_summary }}</h2>
  <ul class="counts">
    {{ range .Counts }}
    <li><span class="value">{{ .Value }}</span> <span class="chip {{ .Severity }}">{{ .Label }}</span></li>
    {{ end }}
  </ul>
  {{ if .NoFindings }}<p>{{ .Strings.report_no_findings }}</p>{{ end }}

  <h2>{{ .Strings.report_checked }}</h2>
  {{ range .Results }}
  <section class="card">
    <div class="result-head">
      <span class="chip {{ .Severity }}">{{ .Label }}</span>
      <span class="check-id">{{ .ID }}</span>
    </div>
    <p class="summary">{{ .Summary }}</p>
    {{ if .Error }}<p class="muted">{{ .Error }}</p>{{ end }}
    {{ if .Cause }}
    <p class="cause"><strong>{{ $.Strings.report_what_this_means }}</strong> {{ .Cause }}</p>
    {{ end }}
    {{ if .Steps }}
    <p class="steps-label"><strong>{{ $.Strings.report_what_to_do }}</strong></p>
    <ul class="steps">{{ range .Steps }}<li>{{ . }}</li>{{ end }}</ul>
    {{ end }}
    {{ if or .Fields .Evidence }}
    <details>
      <summary>{{ $.Strings.report_evidence }}</summary>
      {{ if .Fields }}
      <table>
        <tbody>
        {{ range .Fields }}<tr><th scope="row">{{ .Name }}</th><td>{{ .Value }}</td></tr>{{ end }}
        </tbody>
      </table>
      {{ end }}
      {{ if .Evidence }}<pre>{{ .Evidence }}</pre>{{ end }}
    </details>
    {{ end }}
  </section>
  {{ end }}

  {{ if .Skipped }}
  <h2>{{ .Strings.report_skipped }}</h2>
  <p class="muted">{{ .Strings.report_skipped_note }}</p>
  <ul>{{ range .Skipped }}<li class="check-id">{{ . }}</li>{{ end }}</ul>
  {{ end }}

  <footer>
    <h2>{{ .Strings.report_about }}</h2>
    <p class="muted">{{ .Strings.report_about_body }}</p>
    {{ if .AuditPath }}<p class="muted">{{ .Strings.report_audit }}: {{ .AuditPath }}</p>{{ end }}
  </footer>
</main>
</body>
</html>
